{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}

<h2 class="text-4xl md:text-5xl font-bold mb-14 pt-10 text-gray-800 text-center underline decoration-solid">
    Connexion
</h2>

<div class="max-w-xl mx-auto">

    <div class="bg-white border-[3px] border-black px-8 py-10
                shadow-[6px_8px_0_0_rgba(0,0,0,0.85)]
                transition-all duration-150">

        <form method="post" class="space-y-6">

            {% if error %}
                <div class="bg-red-100 border-[3px] border-black px-4 py-3
                            shadow-[4px_5px_0_0_rgba(0,0,0,0.85)]
                            text-red-800 font-semibold">
                    {# Un seul message : il ne révèle pas si l'e-mail a un compte #}
                    E-mail ou mot de passe incorrect.
                </div>
            {% endif %}

            {% if app.user %}
                <div class="bg-green-100 border-[3px] border-black px-4 py-3
                            shadow-[4px_5px_0_0_rgba(0,0,0,0.85)]
                            text-green-800 font-semibold">
                    Session ouverte avec {{ app.user.userIdentifier }} —
                    <a href="{{ logout_path() }}" class="underline font-bold">Déconnexion</a>
                </div>
            {% endif %}

            <div>
                <label for="username" class="block font-semibold mb-1 text-gray-800">E-mail</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username"
                    class="w-full border-[3px] border-black px-4 py-2
                           shadow-[4px_5px_0_0_rgba(0,0,0,0.85)]
                           focus:outline-none focus:translate-x-1 focus:translate-y-1
                           focus:shadow-[2px_3px_0_0_rgba(0,0,0,0.85)]
                           transition-all"
                    autocomplete="email" required autofocus>
            </div>

            <div>
                <label for="password" class="block font-semibold mb-1 text-gray-800">Mot de passe</label>
                <input type="password" name="_password" id="password"
                    class="w-full border-[3px] border-black px-4 py-2
                           shadow-[4px_5px_0_0_rgba(0,0,0,0.85)]
                           focus:outline-none focus:translate-x-1 focus:translate-y-1
                           focus:shadow-[2px_3px_0_0_rgba(0,0,0,0.85)]
                           transition-all"
                    autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit"
                class="w-full mt-6 bg-white border-[3px] border-black py-3 text-lg font-bold
                       shadow-[6px_8px_0_0_rgba(0,0,0,0.85)]
                       hover:translate-x-1 hover:translate-y-1
                       hover:shadow-[3px_4px_0_0_rgba(0,0,0,0.85)]
                       active:translate-x-2 active:translate-y-2
                       active:shadow-[0_1px_0_0_rgba(0,0,0,0.85)]
                       transition-all duration-150">
                Se connecter
            </button>

        </form>

    </div>

</div>

{% endblock %}
