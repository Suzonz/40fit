{% extends 'base.html.twig' %}
{% import 'partials/_result.html.twig' as result %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
	<article class="w-full max-w-6xl mx-auto mt-6 px-4">

		<h2 class="text-3xl md:text-4xl font-bold mb-2 text-gray-800 text-center">
			Bonjour {{ app.user.firstName }}
		</h2>

		{% if summaries is empty %}
			<p class="text-center text-xl text-gray-700 mt-6 mb-10">
				Vous n'avez pas encore de résultat. Choisissez un défi pour commencer !
			</p>
			<p class="text-center">
				<a href="{{ path('challenge_index') }}" class="inline-block bg-green-800 text-white border-[3px] border-black text-xl px-8 py-3
				          shadow-[4px_6px_0_0_rgba(0,0,0,0.85)] hover:translate-x-1 hover:translate-y-1
				          hover:shadow-[2px_3px_0_0_rgba(0,0,0,0.85)] transition-all duration-150">
					Voir les défis
				</a>
			</p>
		{% else %}
			<p class="text-center text-xl text-gray-700 mb-10">
				{{ evaluationCount }} résultat(s) sur {{ summaries|length }} défi(s),
				objectif atteint pour {{ reachedCount }} d'entre eux.
			</p>

			<ul class="grid grid-cols-1 md:grid-cols-2 gap-8">
				{% for summary in summaries %}
					{% set challenge = summary.challenge %}
					{% set unit = challenge.unit %}
					<li class="bg-white border-[3px] border-black text-gray-800 px-6 py-6 shadow-[6px_8px_0_0_rgba(0,0,0,0.85)] flex flex-col gap-3">
						<div class="flex items-baseline justify-between gap-4">
							<a href="{{ path('challenge_show', { id: challenge.id }) }}" class="text-xl font-bold underline">{{ challenge.title }}</a>
							<span class="text-gray-600 whitespace-nowrap">{{ challenge.category.name }}</span>
						</div>

						<p>
							Dernier résultat : <strong>{{ result.value(summary.latest.value, unit) }}</strong>
							<span class="text-gray-600">({{ summary.latest.createdAt|date('d/m/Y') }})</span>
						</p>
						<p>
							Meilleur : <strong>{{ result.value(summary.best.value, unit) }}</strong>
							— objectif : {{ challenge.lowerBetter ? 'moins de ' }}{{ result.value(challenge.targetValue, unit) }}
						</p>

						{{ result.progress(summary.best.progress) }}
						<p class="font-semibold">
							{% if summary.best.progress >= 100 %}
								Objectif atteint !
							{% else %}
								{{ summary.best.progress }} % de l'objectif
							{% endif %}
						</p>

						{% if summary.count > 1 %}
							{% set gain = summary.latest.value - summary.first.value %}
							{% set better = challenge.isBetter(summary.latest.value, summary.first.value) %}
							<p class="{{ better ? 'text-green-800' : 'text-gray-600' }}">
								{% if gain == 0 %}
									Stable depuis le premier essai ({{ summary.count }} essais).
								{% else %}
									{{ better ? 'En progrès' : 'En recul' }} depuis le premier essai :
									{{ gain > 0 ? '+' : '−' }}{{ result.value(gain|abs, unit) }} ({{ summary.count }} essais)
								{% endif %}
							</p>
						{% endif %}

						<a href="{{ path('challenge_evaluations_create', { id: challenge.id }) }}" class="self-start underline font-semibold">
							Ajouter un résultat
						</a>
					</li>
				{% endfor %}
			</ul>
		{% endif %}

	</article>
{% endblock %}
