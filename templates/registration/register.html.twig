{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}

<h2 class="text-4xl md:text-5xl font-bold mb-14 pt-10 text-gray-800 text-center underline decoration-solid">
    Inscription
</h2>

<div class="max-w-xl mx-auto">

    <div class="bg-white border-[3px] border-black px-8 py-10
                shadow-[6px_8px_0_0_rgba(0,0,0,0.85)]
                transition-all duration-150">

        {{ form_start(registrationForm, {'attr': {'class': 'space-y-6'}}) }}

            {% if form_errors(registrationForm) %}
                <div class="bg-red-100 border-[3px] border-black px-4 py-3
                            shadow-[4px_5px_0_0_rgba(0,0,0,0.85)]
                            text-red-800 font-semibold">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            {% for field in [registrationForm.email, registrationForm.lastName, registrationForm.firstName, registrationForm.plainPassword] %}
                <div>
                    {{ form_label(field, null, { label_attr: { class: 'block font-semibold mb-1 text-gray-800' } }) }}
                    {{ form_widget(field, {
                        attr: {
                            class: 'w-full border-[3px] border-black px-4 py-2
                                    shadow-[4px_5px_0_0_rgba(0,0,0,0.85)]
                                    focus:outline-none focus:translate-x-1 focus:translate-y-1
                                    focus:shadow-[2px_3px_0_0_rgba(0,0,0,0.85)]
                                    transition-all'
                        }
                    }) }}
                    {% if not field.vars.valid %}
                        <div class="mt-2 text-red-800 font-semibold">{{ form_errors(field) }}</div>
                    {% endif %}
                </div>
            {% endfor %}

            <div>
                <div class="flex items-center gap-3">
                    {{ form_widget(registrationForm.agreeTerms, {
                        attr: { class: 'w-5 h-5 border-[3px] border-black' }
                    }) }}
                    {{ form_label(registrationForm.agreeTerms, null, {
                        label_attr: { class: 'font-semibold text-gray-800' }
                    }) }}
                </div>
                {% if not registrationForm.agreeTerms.vars.valid %}
                    <div class="mt-2 text-red-800 font-semibold">{{ form_errors(registrationForm.agreeTerms) }}</div>
                {% endif %}
            </div>

            <button type="submit"
                class="w-full mt-6 bg-white border-[3px] border-black py-3 text-lg font-bold
                       shadow-[6px_8px_0_0_rgba(0,0,0,0.85)]
                       hover:translate-x-1 hover:translate-y-1
                       hover:shadow-[3px_4px_0_0_rgba(0,0,0,0.85)]
                       active:translate-x-2 active:translate-y-2
                       active:shadow-[0_1px_0_0_rgba(0,0,0,0.85)]
                       transition-all duration-150">
                Créer mon compte
            </button>

        {{ form_end(registrationForm) }}

    </div>

</div>

{% endblock %}
