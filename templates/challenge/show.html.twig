{% extends 'base.html.twig' %}

{% block title %}Défi :
	{{ challenge.title }}
{% endblock %}

{% block body %}

	<div class="max-w-5xl mx-auto mt-10 px-4">
		<article class="relative bg-white border-[3px] border-black text-gray-800 px-8 py-8
																                    shadow-[6px_8px_0_0_rgba(0,0,0,0.85)]">

			<div class="mb-6 text-center">
				<h2 class="text-3xl md:text-4xl font-bold mb-4">
					{{ challenge.title }}
				</h2>

				<p class="text-gray-700 text-lg md:text-xl leading-relaxed">
					{{ challenge.description }}
				</p>
			</div>

			<div>
				{{ form_start(evaluationReportForm, {'attr': {'class': 'space-y-6'}}) }}
				{% if form_errors(evaluationReportForm.value) %}
					<div class="bg-red-100 border-[3px] border-black px-4 py-3
																												                            shadow-[4px_5px_0_0_rgba(0,0,0,0.85)]
																												                            text-red-800 font-semibold">
						{{ form_errors(evaluationReportForm.value) }}
					</div>
				{% endif %}

				<div>
					{{ form_label(evaluationReportForm.value, null, { 
        label_attr: { class: 'block font-semibold mb-1 text-gray-800' } 
    }) }}

					{{ form_widget(evaluationReportForm.value, {
        attr: {
            class: 'w-full border-[3px] border-black px-4 py-2
                    shadow-[4px_5px_0_0_rgba(0,0,0,0.85)]
                    focus:outline-none focus:translate-x-1 focus:translate-y-1
                    focus:shadow-[2px_3px_0_0_rgba(0,0,0,0.85)]
                    transition-all'
        }
    }) }}
				</div>


				<button type="submit" class="w-full mt-6 bg-white border-[3px] border-black py-3 text-lg font-bold
												                       shadow-[6px_8px_0_0_rgba(0,0,0,0.85)]
												                       hover:translate-x-1 hover:translate-y-1
												                       hover:shadow-[3px_4px_0_0_rgba(0,0,0,0.85)]
												                       active:translate-x-2 active:translate-y-2
												                       active:shadow-[0_1px_0_0_rgba(0,0,0,0.85)]
												                       transition-all duration-150">
					Enregistrer
				</button>

				{{ form_end(evaluationReportForm) }}

			</div>

		</article>

	</div>

{% endblock %}
