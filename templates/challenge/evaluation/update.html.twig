{% extends 'base.html.twig' %}

{% block title %}Modifier un résultat : {{ challenge.title }}{% endblock %}

{% block body %}
    <div class="max-w-xl mx-auto mt-6 px-4">
        <div class="bg-white border-[3px] border-black px-8 py-8 shadow-[6px_8px_0_0_rgba(0,0,0,0.85)] rounded-md">
            <h2 class="text-3xl font-bold text-center mb-2">{{ challenge.title }}</h2>
            <p class="text-center text-gray-600 mb-4">Résultat du {{ evaluation.createdAt|date('d/m/Y') }}</p>
            {% include 'challenge/evaluation/_form.html.twig' %}
        </div>
    </div>
{% endblock %}
